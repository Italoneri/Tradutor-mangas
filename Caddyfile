# O que fica na frente do app. Tres trabalhos, e nenhum deles e "rotear".
#
# 1. HTTPS. Certificado automatico, renovado sozinho.
# 2. Limites no socket. `http.server` nao tem teto de corpo nem timeout de
#    leitura, e um `ThreadingHTTPServer` exposto na internet cai com um slowloris
#    trivial. Quem segura isso e este arquivo.
# 3. Entregar os bytes. Um capitulo sao 155 JPEGs; se cada imagem ocupasse um
#    worker Python durante o download, quatro leitores derrubariam o servidor.
#    O app autoriza e responde vazio com `X-Accel-Redirect`; o Caddy le do disco.
#
# Troque `tinta.example.com` pelo seu dominio antes de subir, ou defina
# `SITE_ADDRESS`. A bateria do proxy usa `SITE_ADDRESS=:8080` para subir isto
# sem dominio nem certificado.

{
	# Sem isto o Caddy tenta emitir certificado para um dominio que ainda nao
	# aponta para ca, e o primeiro boot falha em silencio.
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS:tinta.example.com} {
	encode zstd gzip

	header {
		# O leitor nao carrega script de terceiro nenhum: tudo que ele executa
		# esta em `reader/`. Uma CSP restrita e barata aqui e cara depois.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Sem `includeSubDomains`: ele obriga HTTPS em todo subdominio do dominio
		# escolhido, inclusive os que nao sao deste servidor, e o navegador guarda a
		# regra por um ano. Ligue so depois de conferir que todos tem certificado.
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		-Server
	}

	# NAO crie um bloco `handle_path /_internal/*` aqui. Ele parece o equivalente
	# do `internal` do nginx e nao e: `internal` nao existe no Caddy, e uma rota de
	# primeiro nivel responde de fora. Com `data/` montado aqui, um `GET
	# /_internal/data/mangatl.db` entregaria o banco - e com os UUIDs de dentro
	# dele, o acervo de qualquer conta. A Fase 3 inteira viraria decoracao, porque
	# existiria um caminho que nao passa por ela.
	#
	# A entrega mora dentro do `reverse_proxy`, abaixo: `handle_response` roda no
	# meio da resposta e nao reentra nas rotas do site, entao o prefixo nunca
	# existe como rota publica. Quem prova isso sao os casos 8 e 9 da bateria, em
	# `caddy_test.py`, que pedem estes caminhos de fora e exigem 404.
	# Um zip de capitulo passa raspando de 100MB; o teto da rota no app e 500MB, e
	# este numero precisa caber os dois. Diretiva de site, e nao subdiretiva do
	# `reverse_proxy`: escrita la dentro o Caddy recusa a configuracao inteira e
	# nem sobe.
	request_body {
		max_size 512MB
	}

	reverse_proxy app:8000 {
		# O IP de quem conectou no Caddy, e nao o que o cliente escreveu: `header_up`
		# sobrescreve o cabecalho que vier de fora. Sem isto o app so ve o IP do
		# Caddy, e o limite de login vira um so para o mundo inteiro - cinco senhas
		# erradas de qualquer pessoa trancam o dono. O app so acredita neste valor
		# quando a conexao vem do endereco em `TRUSTED_PROXIES`.
		header_up X-Real-IP {remote_host}

		# `http.server` nao fecha conexao lenta sozinho. Estes fecham.
		transport http {
			read_timeout 120s
			write_timeout 600s
			dial_timeout 5s
		}

		# A troca que tira o Python do caminho dos bytes: o app responde vazio
		# com o caminho interno, e o Caddy transmite o arquivo.
		#
		# O `route` fixa a ordem. Dentro de um sub-roteador o Caddy ordena pela
		# ordem padrao das diretivas, e nao pela ordem escrita - sem ele o
		# `strip_prefix` roda antes do `rewrite` e apaga o prefixo de um caminho
		# que ainda nem foi reescrito.
		@accel header X-Accel-Redirect *
		handle_response @accel {
			route {
				rewrite * {rp.header.X-Accel-Redirect}
				uri strip_prefix /_internal
				root * /app
				file_server
			}
		}
	}
}
