# Copie para `.env`. O `.dockerignore` mantem este arquivo fora da imagem: a
# chave chega por variavel de ambiente, em tempo de execucao, e `docker history`
# precisa continuar limpo.

# Chave da API Anthropic - usada apenas pelo motor `claude`.
# O motor `free` (Argos) nao precisa de chave.
# Numa instancia publica, deixe VAZIO: o testador nunca usa o `claude`, e uma
# chave presente so aumenta o estrago se algo escapar.
ANTHROPIC_API_KEY=

# O dono. Lidos uma vez, na subida, e gravados como hash - a senha em claro nao
# entra no banco nem no log. Sem os dois, o painel fica sem dono e a instancia
# serve so a vitrine publica.
OWNER_EMAIL=
OWNER_PASSWORD=

# Deixe em 1 em qualquer coisa com HTTPS. `0` so faz sentido no desenvolvimento
# em `http://`, onde um cookie `Secure` nunca volta e a sessao pareceria nao
# existir.
COOKIE_SECURE=1

# Teto de tudo que as areas dos usuarios somadas podem ocupar, em bytes.
# Atingido, upload novo leva 507 em vez de encher o volume - disco cheio derruba
# o banco junto, e ai nem o dono entra. Vazio usa o padrao de 20GB.
MAX_TOTAL_DISK_BYTES=

# Para onde o Let's Encrypt manda aviso de certificado. So o Caddy usa.
ACME_EMAIL=
